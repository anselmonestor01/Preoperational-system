# =============================================================================
# MUNDO MARÍTIMO — Variables de entorno
# Copia este archivo a .env.local y rellena los valores. NO subas .env.local.
# =============================================================================

# --- Públicas (seguras para el navegador) ---
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave publishable (sb_publishable_...) o anon. Es pública por diseño; RLS protege los datos.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# --- Privadas (SÓLO en el servidor; NUNCA en el navegador ni en el repo) ---
# Necesaria únicamente para operaciones administrativas server-side
# (crear usuarios del panel / invitaciones). No se expone al cliente.
SUPABASE_SERVICE_ROLE_KEY=
